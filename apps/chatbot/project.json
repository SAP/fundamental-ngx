{
    "name": "@fundamental-ngx/chatbot",
    "tags": ["scope:chatbot", "type:app"],
    "targets": {
        "build": {
            "dependsOn": ["mcp-server:extract-metadata"]
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest run",
                "cwd": "apps/chatbot",
                "forwardAllArgs": false
            }
        }
    }
}
